{
  "name": "jobradar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next dev",
    "build": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next build",
    "start": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next start",
    "crawl": "bun run scripts/crawl.ts",
    "crawl:dry": "bun run scripts/crawl.ts --dry-run",
    "analyze": "bun run scripts/analyze.ts",
    "test:scoring": "bun run scripts/test-scoring.ts",
    "db:reset": "bun run scripts/reset-db.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^7.0.2"
  }
}
